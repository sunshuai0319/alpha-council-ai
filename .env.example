# docker compose 部署用：复制为 .env 后填写。
#
# 三个 env 文件的分工（避免重复困惑）：
#   ./.env          本文件 —— 仅 docker compose 部署用（网关端口、模型目录、前端构建参数）
#   ./backend/.env  后端与 worker（本地开发与容器共用）
#   ./frontend/.env 前端本地开发（npm run dev）；容器里只取它的 CLERK_SECRET_KEY

# 对外端口。192.168.0.106 上 80 / 3000 / 9000 已被占用，8080 也避开以免撞默认服务。
GATEWAY_PORT=8888

# BGE 模型所在目录（宿主机路径，不是开发机的）。必须同时包含 bge-m3 与
# bge-reranker-v2-m3，共约 12.8G，以只读方式挂载到容器内 /models。
MODEL_DIR=/path/to/models

# ---- 前端公开变量 ----
# 这些值**必须与 frontend/.env 一致**：构建时会被内联进前端 bundle 与
# .next/server/middleware.js（实测缺了会直接抛 "Missing publishableKey"）。
# 改了之后必须重建：docker compose build web && docker compose up -d web
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
