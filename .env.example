# docker compose 用：复制为 .env 后填写。
# 后端与 worker 的配置在 backend/.env，这里只管网关与前端。

# 对外端口。192.168.0.106 上 80 / 3000 / 9000 已被占用，8080 也避开以免撞默认服务。
GATEWAY_PORT=8888

# BGE 模型所在目录（宿主机）。必须同时包含 bge-m3 与 bge-reranker-v2-m3，
# 共约 12.8G，以只读方式挂载到容器内 /models。
# 注意：这是**部署主机**上的路径，不是开发机的路径。
MODEL_DIR=/path/to/models

# Clerk 可发布密钥。构建时会内联进前端 bundle，改这里之后必须：
#   docker compose build web && docker compose up -d web
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
