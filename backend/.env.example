APP_ENV=development
LOG_LEVEL=INFO

# Existing external PostgreSQL and Milvus services.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/alpha_council_ai
MILVUS_URI=http://localhost:19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_COLLECTION=alpha_council_documents_bge_m3_v1

# Local embedding and reranking models.
EMBEDDING_MODEL_PATH=/Volumes/wd2t/model/bge-m3
RERANKER_MODEL_PATH=/Volumes/wd2t/model/bge-reranker-v2-m3

# Volcengine Ark.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=deepseek-v4-pro-ga-260813
ARK_TIMEOUT_SECONDS=60

# WEEX virtual futures account only.
WEEX_BASE_URL=https://api-contract.weex.com
WEEX_VIRTUAL_ONLY=true

# Clerk backend verification.
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Application safety defaults.
# 全局交易开关：设为 false 会停掉所有账户的新决策（保留行情采集与对账）。
TRADING_ENABLED=true
# 平台硬上限。虚拟盘实际杠杆固定 20x 且不可调，上限必须 >= 20，
# 否则虚拟盘一开仓就再也无法加仓（max_leverage 会拒掉）。
MAX_LEVERAGE=20
MAX_DAILY_TRADES=20
MAX_POSITION_NOTIONAL_PCT=0.20
MAX_SINGLE_TRADE_RISK_PCT=0.005
MAX_DAILY_LOSS_PCT=0.05
MAX_CONSECUTIVE_LOSSES=3
MAX_CONSECUTIVE_FAILURES=5
MARKET_DATA_MAX_AGE_SECONDS=90
DECISION_INTERVAL_SECONDS=300

# FRED 序列重抓间隔，按各自更新频率：月度序列按分钟级频率重抓毫无收益，
# 而且每 5 分钟打 5 个 fredgraph.csv 请求（约 1440 次/天）会招来 503。
FRED_MONTHLY_INTERVAL_SECONDS=86400
FRED_DAILY_INTERVAL_SECONDS=3600
# 策略参数：打分卡 + 仓位反推 + 持仓管理。
# 默认值就是系统一直在用的值（见 app/signals/params.py），改这里不用改代码。
# 风险预算不在这里另开字段：它与 MAX_SINGLE_TRADE_RISK_PCT /
# MAX_POSITION_NOTIONAL_PCT 是同一个概念，共用上面那一对。
STRATEGY_TREND_WEIGHT=0.40
STRATEGY_MOMENTUM_WEIGHT=0.25
STRATEGY_VOLUME_WEIGHT=0.15
# composite 超过这个绝对值才开仓。调高 = 更少更挑的交易。
STRATEGY_ENTRY_THRESHOLD=0.35
# 止损 = k × ATR(1h)。调宽会同时降频并压低手续费占比（费用/R = 2×费率÷止损距离）。
STRATEGY_ATR_MULTIPLIER=1.5
# 止盈 = entry ± rr × 止损距离。
STRATEGY_REWARD_RISK=2.0
# 交易所侧那条宽灾难止损 = k × 止损距离。交易所的触发单改不了也撤不掉，
# 所以那边只放这条兜底，紧的那条由软件层管。
STRATEGY_DISASTER_MULTIPLIER=3.0
# 浮盈到多少 R 把止损移到保本。
STRATEGY_BREAKEVEN_R=1.0
# 移动止损的跟随距离 = k × ATR(1h)。
STRATEGY_TRAIL_ATR_MULTIPLIER=1.0
# 持仓超过这么久且浮盈不足 STRATEGY_TIME_STOP_MIN_R 就平掉。
STRATEGY_TIME_STOP_HOURS=48
STRATEGY_TIME_STOP_MIN_R=0.3
# 最低盈亏比：低于它就是「赚小亏大」。
MIN_REWARD_RISK=1.5
