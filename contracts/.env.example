# Base Sepolia RPC URL. Use a provider URL from Alchemy, QuickNode, Infura, Ankr, or another provider.
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Testnet-only deployer key. Never use a mainnet wallet or a wallet holding real funds.
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Optional: used only when adding Hardhat contract verification.
ETHERSCAN_API_KEY=
